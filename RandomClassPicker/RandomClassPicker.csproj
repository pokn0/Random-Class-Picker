<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RandomClassPicker</AssemblyName>
    <RootNamespace>RandomClassPicker</RootNamespace>
    <Version>0.0.0.1</Version>
    <Authors>pokn</Authors>
    <Description>用真随机（random.org）抽一个职业并切换过去</Description>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(APPDATA)\XIVLauncherCN\devPlugins\$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

</Project>
